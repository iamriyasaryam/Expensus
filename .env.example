# ==============================================================================
# Expensus — Environment Configuration Template
# Copy this file to '.env' for local development:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: Django Core Settings
# ------------------------------------------------------------------------------
# In production, use a randomly generated 50+ character string.
DJANGO_SECRET_KEY=django-insecure-expensus-dev-secret-key-change-in-production-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# ------------------------------------------------------------------------------
# Backend: Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Set USE_SQLITE=True if you want to run quick local tests without PostgreSQL/Docker.
USE_SQLITE=False
DB_NAME=expensus_db
DB_USER=expensus_user
DB_PASSWORD=expensus_password
# When running with Docker Compose, DB_HOST must be 'db' (the service name).
# When running Django natively on your host machine connecting to Docker DB, use 'localhost'.
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Backend: Security & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origins for frontend clients (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Backend: JWT Authentication (SimpleJWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Frontend: Vite Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
